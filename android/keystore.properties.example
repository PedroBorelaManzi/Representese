## Copie este arquivo para "keystore.properties" (mesma pasta) e preencha com os
## dados reais do seu keystore. O arquivo "keystore.properties" NUNCA vai pro Git
## (já está no .gitignore) — só existe na sua máquina.
storeFile=../representese-release.keystore
storePassword=SUA_SENHA_DO_KEYSTORE_AQUI
keyAlias=representese
keyPassword=SUA_SENHA_DA_CHAVE_AQUI
