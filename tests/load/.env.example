# Copie para tests/load/.env e preencha. NUNCA commitar o .env preenchido.
# Uso:  set -a; source tests/load/.env; set +a; PROFILE=stress k6 run tests/load/site.js

# --- Site / SPA (deploy de preview/staging da Vercel, SEM barra no fim) ---
SITE_URL=https://representese-git-staging-xxxx.vercel.app

# --- Supabase de STAGING (jamais o de produção: wdtftftwdqtihupbtlxk) ---
SUPABASE_URL=https://xxxxstaging.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- Usuário de teste que existe no projeto de staging, com dados semeados ---
TEST_EMAIL=loadtest@representese.com
TEST_PASSWORD=troque-isto

# --- Opcionais ---
# PROFILE=smoke|load|stress|spike   (default: load)
# PEAK_VUS=300                       (sobrescreve o pico do perfil)
# HOLIDAYS_RATIO=0.1                 (fração das iterações que chamam get-holidays)
