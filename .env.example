# Front-End (Vite Públicas)
VITE_SUPABASE_URL=sua_url_do_supabase_aqui
VITE_SUPABASE_ANON_KEY=sua_anon_key_do_supabase_aqui

# Observabilidade (opcionais — sem elas, viram no-op silencioso)
VITE_SENTRY_DSN=seu_dsn_do_sentry_aqui
VITE_POSTHOG_KEY=sua_project_api_key_do_posthog_aqui
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google OAuth — Client ID "Web application" usado no login web (VITE_GOOGLE_CLIENT_ID
# já configurado direto no Vercel). Os dois abaixo são NOVOS Client IDs "públicos"
# (tipo iOS / tipo Android, sem client_secret) exigidos pelo fluxo OAuth nativo do
# Capacitor (system browser + PKCE) — ver src/lib/nativeGoogleAuth.ts.
VITE_GOOGLE_IOS_CLIENT_ID=seu_client_id_ios_aqui
VITE_GOOGLE_ANDROID_CLIENT_ID=seu_client_id_android_aqui

# Previsão do tempo: Open-Meteo (https://open-meteo.com) — sem chave, nada a configurar aqui.

# Back-End (Secretas - NÃO expor no frontend)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Assina o token de sessão do link de "enviar pedido" (api/order-intake.ts) —
# qualquer string longa e aleatória serve, ex.: `openssl rand -hex 32`.
ORDER_INTAKE_SESSION_SECRET=uma_string_aleatoria_bem_longa_aqui

# Rate limiting / teto de sessões (Upstash Redis) — sem estas, tanto o rate
# limit da IA quanto o teto global de sessões ficam DESLIGADOS (fail-open).
UPSTASH_REDIS_REST_URL=sua_url_do_upstash_aqui
UPSTASH_REDIS_REST_TOKEN=seu_token_do_upstash_aqui

# Teto global de sessões ativas simultâneas (api/_lib/sessionGate.ts).
# Opcionais — valores padrão entre parênteses.
SESSION_LIMIT=150          # (150) usuários ativos ao mesmo tempo
SESSION_TTL_MS=120000      # (120000) tempo sem heartbeat até liberar a vaga
